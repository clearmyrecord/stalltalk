generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ADVERTISER
  VENUE
}

enum CampaignStatus {
  DRAFT
  PAYMENT_PENDING
  PENDING_PAYMENT
  PAID
  APPROVED
  REJECTED
  ACTIVE
  EXPIRED
  ARCHIVED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum InventoryStatus {
  OPEN
  RESERVED
  SOLD
  DISABLED
}

enum ApprovalStatus {
  DRAFT
  SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum IssueStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum ContentBlockType {
  ARTICLE
  QUOTE
  FACT
  JOKE
  CALENDAR
  EVENT
  COUPON
  ADVERTISEMENT
  RESTAURANT_REVIEW
}

enum AdStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum AdScope {
  GLOBAL
  CITY
  VENUE
  RESTROOM
}

enum AnalyticsEventType {
  SCAN
  PAGE_VIEW
  TIME_ON_PAGE
  AD_IMPRESSION
  AD_CLICK
  COUPON_REDEMPTION
  REVIEW_VIEW
  REVIEW_WEBSITE_CLICK
  REVIEW_SOCIAL_CLICK
}

enum QrCodeStatus {
  INVENTORY
  ASSIGNED
  RETIRED
}

enum StripeSubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  role         Role
  passwordHash String
  status       AccountStatus @default(ACTIVE)
  advertiserId String?
  venueId      String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  advertiser   Advertiser?   @relation(fields: [advertiserId], references: [id], onDelete: SetNull)
  venue        Venue?        @relation(fields: [venueId], references: [id], onDelete: SetNull)
  sessions     AuthSession[]
}

model AuthSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Publisher {
  id              String                     @id @default(cuid())
  name            String
  slug            String                     @unique
  contactEmail    String
  status          AccountStatus              @default(ACTIVE)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  distributors    Distributor[]
  advertisers     Advertiser[]
  venues          Venue[]
  articles        Article[]
  categories      Category[]
  ads             Ad[]
  campaignHistory StalltalkCampaignHistory[]
  adSlots         StalltalkAdSlot[]
  issues          Issue[]
  qrCodes         QrCode[]
  events          AnalyticsEvent[]
  restaurantReviews RestaurantReview[]
}

model Distributor {
  id                String             @id @default(cuid())
  publisherId       String
  name              String
  slug              String
  contactEmail      String
  commissionRate    Decimal            @default(0.15)
  status            AccountStatus      @default(ACTIVE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  publisher         Publisher          @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  venues            Venue[]
  commissionReports CommissionReport[]

  @@unique([publisherId, slug])
}

model Advertiser {
  id              String                     @id @default(cuid())
  publisherId     String
  name            String
  slug            String
  contactEmail    String
  status          AccountStatus              @default(ACTIVE)
  portalNote      String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  publisher       Publisher                  @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  ads             Ad[]
  subscriptions   StripeSubscription[]
  couponCampaigns CouponCampaign[]
  campaignHistory StalltalkCampaignHistory[]
  analyticsEvents AnalyticsEvent[]
  users           User[]
  adCampaigns     AdCampaign[]
  payments        Payment[]

  @@unique([publisherId, slug])
}

model Venue {
  id                 String              @id @default(cuid())
  publisherId        String
  distributorId      String?
  name               String
  slug               String              @unique
  city               String
  state              String
  address            String
  venueType          String              @default("venue") @map("venue_type")
  isActive           Boolean             @default(true) @map("is_active")
  status             AccountStatus       @default(ACTIVE)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  publisher          Publisher           @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  distributor        Distributor?        @relation(fields: [distributorId], references: [id], onDelete: SetNull)
  restrooms          Restroom[]
  issues             Issue[]
  qrCodes            QrCode[]
  ads                Ad[]
  events             AnalyticsEvent[]
  users              User[]
  toiletLocations    ToiletLocation[]
  adSlotInventories  AdSlotInventory[]
  venueContentDrafts VenueContentDraft[]
  restaurantReviews  RestaurantReview[]
}

model Restroom {
  id                String            @id @default(cuid())
  venueId           String
  name              String
  floor             String?
  placement         String?
  status            AccountStatus     @default(ACTIVE)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  venue             Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)
  qrCodes           QrCode[]
  issues            Issue[]
  ads               Ad[]
  events            AnalyticsEvent[]
  toiletLocations   ToiletLocation[]
  adSlotInventories AdSlotInventory[]
}

model QrCode {
  id                String            @id @default(cuid())
  publisherId       String
  venueId           String?
  restroomId        String?
  code              String            @unique
  label             String
  destination       String
  status            QrCodeStatus      @default(INVENTORY)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  publisher         Publisher         @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  venue             Venue?            @relation(fields: [venueId], references: [id], onDelete: SetNull)
  restroom          Restroom?         @relation(fields: [restroomId], references: [id], onDelete: SetNull)
  issues            Issue[]
  events            AnalyticsEvent[]
  toiletLocations   ToiletLocation[]
  adSlotInventories AdSlotInventory[]
}

model Category {
  id          String    @id @default(cuid())
  publisherId String
  name        String
  slug        String
  color       String    @default("#ffd400")
  publisher   Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  articles    Article[]

  @@unique([publisherId, slug])
}

model Article {
  id          String              @id @default(cuid())
  publisherId String
  categoryId  String?
  title       String
  slug        String
  excerpt     String
  body        String
  imageUrl    String?
  status      IssueStatus         @default(DRAFT)
  scheduledAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  publisher   Publisher           @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  category    Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  blocks      IssueContentBlock[]
  venueIds    String[]            @default([])

  @@unique([publisherId, slug])
}

model RestaurantReview {
  id               String              @id @default(cuid())
  publisherId      String
  title            String
  restaurantName   String              @map("restaurant_name")
  venueId          String?             @map("venue_id")
  venueIds         String[]            @default([]) @map("venue_ids")
  featuredImageUrl String?             @map("featured_image_url")
  starRating       Decimal             @default(5.0) @map("star_rating")
  cuisineType      String?             @map("cuisine_type")
  address          String?
  city             String?
  state            String?
  websiteUrl       String?             @map("website_url")
  instagramUrl     String?             @map("instagram_url")
  facebookUrl      String?             @map("facebook_url")
  reviewHeadline   String              @map("review_headline")
  reviewBody       String              @map("review_body")
  reviewerName     String              @map("reviewer_name")
  publishDate      DateTime?           @map("publish_date")
  status           IssueStatus         @default(DRAFT)
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  publisher        Publisher           @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  venue            Venue?              @relation(fields: [venueId], references: [id], onDelete: SetNull)

  @@index([publisherId, status, publishDate])
  @@index([venueId])
  @@map("restaurant_reviews")
}

model Issue {
  id            String              @id @default(cuid())
  publisherId   String
  venueId       String
  restroomId    String?
  qrCodeId      String?
  title         String
  month         String
  year          Int
  issueNumber   Int
  status        IssueStatus         @default(DRAFT)
  scheduledAt   DateTime?
  publishedAt   DateTime?
  republishedAt DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  publisher     Publisher           @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  venue         Venue               @relation(fields: [venueId], references: [id], onDelete: Cascade)
  restroom      Restroom?           @relation(fields: [restroomId], references: [id], onDelete: SetNull)
  qrCode        QrCode?             @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)
  contentBlocks IssueContentBlock[]
  adSlots       IssueAdSlot[]
  events        AnalyticsEvent[]
}

model IssueContentBlock {
  id        String           @id @default(cuid())
  issueId   String
  articleId String?
  type      ContentBlockType
  title     String
  body      String
  imageUrl  String?
  layout    Json?
  venueIds  String[]         @default([])
  sortOrder Int              @default(0)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  issue     Issue            @relation(fields: [issueId], references: [id], onDelete: Cascade)
  article   Article?         @relation(fields: [articleId], references: [id], onDelete: SetNull)
}

model Ad {
  id                   String                     @id @default(cuid())
  publisherId          String
  advertiserId         String
  businessName         String
  title                String
  offer                String
  artworkUrl           String?
  creativeType         String                     @default("IMAGE")
  htmlCreative         String?
  videoUrl             String?
  promptUsed           String?
  generatedHeadline    String?
  generatedSubheadline String?
  adSize               String?
  ctaText              String
  targetUrl            String
  phone                String?
  couponCode           String?
  status               AdStatus                   @default(ACTIVE)
  scope                AdScope                    @default(GLOBAL)
  city                 String?
  state                String?
  venueId              String?
  venueIds             String[]                   @default([])
  restroomId           String?
  monthlyPriceCents    Int                        @default(0)
  stripePriceId        String?
  campaignStartsAt     DateTime?
  campaignEndsAt       DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  publisher            Publisher                  @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  advertiser           Advertiser                 @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  venue                Venue?                     @relation(fields: [venueId], references: [id], onDelete: SetNull)
  restroom             Restroom?                  @relation(fields: [restroomId], references: [id], onDelete: SetNull)
  issueSlots           IssueAdSlot[]
  campaignHistory      StalltalkCampaignHistory[]
  adSlots              StalltalkAdSlot[]
  events               AnalyticsEvent[]
  subscriptions        StripeSubscription[]
  adCampaigns          AdCampaign[]
}

model IssueAdSlot {
  id         String  @id @default(cuid())
  issueId    String
  adId       String
  slotNumber Int
  source     AdScope @default(GLOBAL)
  issue      Issue   @relation(fields: [issueId], references: [id], onDelete: Cascade)
  ad         Ad      @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@unique([issueId, slotNumber])
}

model StalltalkCampaignHistory {
  id            String      @id @default(cuid())
  publisherId   String?
  advertiserId  String?
  adId          String?
  campaignId    String      @unique
  business      String
  image         String?
  prompt        String
  headline      String?
  subheadline   String?
  ctaText       String?
  couponCode    String?
  adSize        String      @default("Banner")
  slotPublished Int?
  createdAt     DateTime    @default(now())
  publisher     Publisher?  @relation(fields: [publisherId], references: [id], onDelete: SetNull)
  advertiser    Advertiser? @relation(fields: [advertiserId], references: [id], onDelete: SetNull)
  ad            Ad?         @relation(fields: [adId], references: [id], onDelete: SetNull)

  @@map("stalltalk_campaign_history")
}

model StalltalkAdSlot {
  id           String     @id @default(cuid())
  slotNumber   Int        @unique
  adId         String?
  business     String
  creativeType String     @default("IMAGE")
  image        String?
  htmlCreative String?
  videoUrl     String?
  prompt       String?
  headline     String?
  subheadline  String?
  ctaText      String?
  couponCode   String?
  targetUrl    String?
  phone        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  ad           Ad?        @relation(fields: [adId], references: [id], onDelete: SetNull)
  publisher    Publisher? @relation(fields: [publisherId], references: [id])
  publisherId  String?

  @@map("stalltalk_ad_slots")
}

model AnalyticsEvent {
  id           String             @id @default(cuid())
  publisherId  String?
  venueId      String?
  restroomId   String?
  qrCodeId     String?
  issueId      String?
  advertiserId String?
  adId         String?
  type         AnalyticsEventType
  slotNumber   Int?
  visitorId    String?
  sessionId    String?
  durationMs   Int?
  path         String?
  metadata     Json?
  createdAt    DateTime           @default(now())
  publisher    Publisher?         @relation(fields: [publisherId], references: [id], onDelete: SetNull)
  advertiser   Advertiser?        @relation(fields: [advertiserId], references: [id], onDelete: SetNull)
  venue        Venue?             @relation(fields: [venueId], references: [id], onDelete: SetNull)
  restroom     Restroom?          @relation(fields: [restroomId], references: [id], onDelete: SetNull)
  qrCode       QrCode?            @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)
  issue        Issue?             @relation(fields: [issueId], references: [id], onDelete: SetNull)
  ad           Ad?                @relation(fields: [adId], references: [id], onDelete: SetNull)
}

model StripeSubscription {
  id                   String                   @id @default(cuid())
  advertiserId         String
  adId                 String?
  stripeCustomerId     String
  stripeSubscriptionId String
  status               StripeSubscriptionStatus @default(TRIALING)
  locations            Int                      @default(1)
  monthlyAmountCents   Int
  currentPeriodEndsAt  DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  advertiser           Advertiser               @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  ad                   Ad?                      @relation(fields: [adId], references: [id], onDelete: SetNull)
}

model ToiletLocation {
  id          String            @id @default(cuid())
  venueId     String
  restroomId  String?
  qrCodeId    String?
  name        String
  label       String
  placement   String?
  status      AccountStatus     @default(ACTIVE)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  venue       Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)
  restroom    Restroom?         @relation(fields: [restroomId], references: [id], onDelete: SetNull)
  qrCode      QrCode?           @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)
  inventories AdSlotInventory[]

  @@index([venueId])
  @@index([restroomId])
  @@index([qrCodeId])
}

model AdSlotInventory {
  id                 String                @id @default(cuid())
  venueId            String
  restroomId         String?
  qrCodeId           String?
  toiletLocationId   String?
  slotNumber         Int
  month              String
  startsAt           DateTime?
  endsAt             DateTime?
  priceCents         Int                   @default(5000)
  status             InventoryStatus       @default(OPEN)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  venue              Venue                 @relation(fields: [venueId], references: [id], onDelete: Cascade)
  restroom           Restroom?             @relation(fields: [restroomId], references: [id], onDelete: SetNull)
  qrCode             QrCode?               @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)
  toiletLocation     ToiletLocation?       @relation(fields: [toiletLocationId], references: [id], onDelete: SetNull)
  campaigns          AdCampaign[]
  campaignPlacements AdCampaignPlacement[]

  @@unique([venueId, restroomId, qrCodeId, slotNumber, month])
  @@index([status, month])
}

model AdCampaign {
  id                          String                @id @default(cuid())
  advertiserId                String
  inventoryId                 String?
  adId                        String?
  name                        String
  businessName                String
  headline                    String
  body                        String
  creativeUrl                 String?
  targetUrl                   String                @default("#")
  ctaText                     String                @default("Learn More")
  months                      Int                   @default(1)
  locationCount               Int                   @default(1)
  priceCents                  Int                   @default(5000)
  flightStartMonth            String                @default("2026-07")
  flightEndMonth              String                @default("2026-07")
  flightMonths                Int                   @default(1)
  pricePerPlacementMonthCents Int                   @default(5000)
  placementCount              Int                   @default(1)
  totalAmountCents            Int                   @default(5000)
  status                      CampaignStatus        @default(DRAFT)
  approvalStatus              ApprovalStatus        @default(PENDING)
  adminApprovalNote           String?
  rejectionReason             String?
  stripeSessionId             String?               @unique
  paidAt                      DateTime?
  startsAt                    DateTime?
  endsAt                      DateTime?
  submittedAt                 DateTime?
  approvedAt                  DateTime?
  rejectedAt                  DateTime?
  approvedBy                  String?
  rejectedBy                  String?
  publishedAt                 DateTime?
  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime              @updatedAt
  advertiser                  Advertiser            @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  inventory                   AdSlotInventory?      @relation(fields: [inventoryId], references: [id], onDelete: SetNull)
  ad                          Ad?                   @relation(fields: [adId], references: [id], onDelete: SetNull)
  payments                    Payment[]
  placements                  AdCampaignPlacement[]

  @@index([advertiserId, status])
  @@index([inventoryId])
  @@index([flightStartMonth, flightEndMonth])
}

model AdCampaignPlacement {
  id          String          @id @default(cuid())
  campaignId  String
  inventoryId String
  createdAt   DateTime        @default(now())
  campaign    AdCampaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  inventory   AdSlotInventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@unique([campaignId, inventoryId])
  @@index([inventoryId])
}

model Payment {
  id                    String        @id @default(cuid())
  campaignId            String
  advertiserId          String
  amountCents           Int
  currency              String        @default("usd")
  status                PaymentStatus @default(PENDING)
  stripeSessionId       String?       @unique
  stripePaymentIntentId String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  campaign              AdCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  advertiser            Advertiser    @relation(fields: [advertiserId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([advertiserId])
}

model VenueContentDraft {
  id              String         @id @default(cuid())
  venueId         String
  title           String
  body            String
  imageUrl        String?
  approvalStatus  ApprovalStatus @default(DRAFT)
  adminNote       String?
  rejectionReason String?
  submittedAt     DateTime?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  approvedBy      String?
  rejectedBy      String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  venue           Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId, approvalStatus])
}

model CouponCampaign {
  id              String     @id @default(cuid())
  advertiserId    String
  name            String
  couponCode      String
  budgetCents     Int        @default(0)
  redemptionLimit Int?
  startsAt        DateTime?
  endsAt          DateTime?
  createdAt       DateTime   @default(now())
  advertiser      Advertiser @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
}

model CommissionReport {
  id                String      @id @default(cuid())
  distributorId     String
  month             String
  year              Int
  grossRevenueCents Int
  commissionCents   Int
  status            String      @default("OPEN")
  createdAt         DateTime    @default(now())
  distributor       Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)
}

model PublishedContent {
  id          String   @id @default(cuid())
  issue       Json
  ads         Json
  events      Json
  venues      Json
  settings    Json
  publishedAt DateTime @default(now())
  publishedBy Json?
  createdAt   DateTime @default(now())

  @@index([publishedAt])
}
