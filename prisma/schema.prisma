generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  VENUE_MANAGER
  ADVERTISER
  DISTRIBUTOR
}

enum CampaignStatus {
  DRAFT
  SUBMITTED
  PAYMENT_PENDING
  PENDING_PAYMENT
  PAID
  APPROVED
  REJECTED
  ACTIVE
  PAUSED
  EXPIRED
  ARCHIVED
}

enum CreativeKind {
  IMAGE
  COUPON
  BANNER
  SPONSORED_ARTICLE
  RESTAURANT_PROMOTION
  EVENT_PROMOTION
}

enum TargetType {
  GLOBAL_NETWORK
  STATE
  CITY
  VENUE
  VENUE_TYPE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
}

enum CreativeApprovalStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  FLAGGED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum InventoryStatus {
  OPEN
  RESERVED
  SOLD
  DISABLED
}

enum ApprovalStatus {
  DRAFT
  SUBMITTED
  PENDING
  APPROVED
  REJECTED
  PUBLISHED
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum IssueStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum EventStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  HIDDEN
  PUBLISHED
}

enum VenueContentType {
  ANNOUNCEMENT
  PROMOTION
  EVENT
  RESTAURANT_REVIEW
  PHOTO
  COUPON
  FEATURED_CONTENT
}

enum VenuePromotionCategory {
  HAPPY_HOUR
  RESTAURANT
  RETAIL
  HOTEL_PACKAGE
  ENTERTAINMENT
}

enum MediaAssetType {
  IMAGE
  LOGO
  GALLERY
}

enum ContentBlockType {
  ARTICLE
  QUOTE
  FACT
  JOKE
  CALENDAR
  EVENT
  COUPON
  ADVERTISEMENT
  RESTAURANT_REVIEW
  ANNOUNCEMENT
  SPONSOR_SLOT
  MISSION
  HILARIOUSLY_FUNNY
  FEATURE_ARTICLE
  EVENT_CALENDAR
  LOCAL_DEALS
  TRIVIA
  INSPIRATIONAL_QUOTES
  WORD_OF_THE_MONTH
}

enum AdStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum AdScope {
  GLOBAL
  CITY
  VENUE
  RESTROOM
}

enum AnalyticsEventType {
  SCAN
  PAGE_VIEW
  TIME_ON_PAGE
  AD_IMPRESSION
  AD_CLICK
  COUPON_REDEMPTION
  COUPON_CLICK
  ISSUE_VIEW
  WEBSITE_VISIT
  REVIEW_VIEW
  REVIEW_WEBSITE_CLICK
  REVIEW_SOCIAL_CLICK
}

enum QrCodeStatus {
  DRAFT
  PRINTED
  DEPLOYED
  ACTIVE
  RETIRED
  ARCHIVED
}

enum QrCodeType {
  VENUE
  RESTROOM
  CAMPAIGN
  TEST
  GLOBAL
  ISSUE
}

enum QrStickerTemplate {
  STALL_DOOR
  URINAL_WALL
  TABLE_TENT
  WINDOW_STICKER
}

enum QrDestinationType {
  GLOBAL
  VENUE
  LOCATION
  ISSUE
}

enum QrLifecycleAction {
  CREATE
  PRINT
  DEPLOY
  REPLACE
  RETIRE
}

enum QrPlacementType {
  STALL
  MIRROR
  URINAL
  ENTRANCE
  OTHER
}

enum IssueTargetType {
  VENUE
  RESTROOM
  QR_PLACEMENT
}

enum StripeSubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String
  role                Role
  passwordHash        String
  status              AccountStatus        @default(ACTIVE)
  advertiserId        String?
  venueId             String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  advertiser          Advertiser?          @relation(fields: [advertiserId], references: [id], onDelete: SetNull)
  venue               Venue?               @relation(fields: [venueId], references: [id], onDelete: SetNull)
  sessions            AuthSession[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

model AuthSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Publisher {
  id                String                     @id @default(cuid())
  name              String
  slug              String                     @unique
  contactEmail      String
  status            AccountStatus              @default(ACTIVE)
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  distributors      Distributor[]
  advertisers       Advertiser[]
  venues            Venue[]
  articles          Article[]
  categories        Category[]
  ads               Ad[]
  campaignHistory   StalltalkCampaignHistory[]
  adSlots           StalltalkAdSlot[]
  issues            Issue[]
  qrCodes           QrCode[]
  qrScans           QrScan[]
  events            AnalyticsEvent[]
  restaurantReviews RestaurantReview[]
}

model Distributor {
  id                String             @id @default(cuid())
  publisherId       String
  name              String
  slug              String
  contactEmail      String
  commissionRate    Decimal            @default(0.15)
  status            AccountStatus      @default(ACTIVE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  publisher         Publisher          @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  venues            Venue[]
  commissionReports CommissionReport[]
  assignedQrCodes   QrCode[]

  @@unique([publisherId, slug])
}

model Advertiser {
  id              String                     @id @default(cuid())
  publisherId     String
  name            String
  slug            String
  contactEmail    String
  status          AccountStatus              @default(ACTIVE)
  portalNote      String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  publisher       Publisher                  @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  ads             Ad[]
  subscriptions   StripeSubscription[]
  couponCampaigns CouponCampaign[]
  campaignHistory StalltalkCampaignHistory[]
  analyticsEvents AnalyticsEvent[]
  users           User[]
  adCampaigns     AdCampaign[]
  adCreatives     AdCreative[]
  invoices        AdvertiserInvoice[]
  payments        Payment[]

  @@unique([publisherId, slug])
}

model Venue {
  id                       String              @id @default(cuid())
  publisherId              String
  distributorId            String?
  defaultIssueId           String?
  name                     String
  slug                     String              @unique
  publicToken              String              @unique @default(uuid())
  city                     String
  state                    String
  timeZone                 String              @default("America/Los_Angeles")
  zip                      String?
  address                  String
  venueType                String              @default("venue") @map("venue_type")
  phone                    String?
  website                  String?
  contactName              String?             @map("contact_name")
  contactEmail             String?             @map("contact_email")
  description              String?
  logoImageUrl             String?             @map("logo_image_url")
  isActive                 Boolean             @default(true) @map("is_active")
  directPublishingApproved Boolean             @default(false)
  status                   AccountStatus       @default(ACTIVE)
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  publisher                Publisher           @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  distributor              Distributor?        @relation(fields: [distributorId], references: [id], onDelete: SetNull)
  defaultIssue             DefaultIssue?       @relation(fields: [defaultIssueId], references: [id], onDelete: SetNull)
  restrooms                Restroom[]
  issues                   Issue[]
  qrCodes                  QrCode[]
  issueTargets             IssueTarget[]
  qrScans                  QrScan[]
  ads                      Ad[]
  events                   AnalyticsEvent[]
  users                    User[]
  toiletLocations          ToiletLocation[]
  adSlotInventories        AdSlotInventory[]
  venueContentDrafts       VenueContentDraft[]
  mediaAssets              VenueMediaAsset[]
  restaurantReviews        RestaurantReview[]
}

model Restroom {
  id                String            @id @default(cuid())
  venueId           String
  name              String
  slug              String?
  restroomType      String            @default("ALL_GENDER")
  customTypeLabel   String?
  floor             String?
  placement         String?
  status            AccountStatus     @default(ACTIVE)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  venue             Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)
  qrCodes           QrCode[]
  qrScans           QrScan[]
  issues            Issue[]
  ads               Ad[]
  events            AnalyticsEvent[]
  toiletLocations   ToiletLocation[]
  adSlotInventories AdSlotInventory[]
  issueTargets      IssueTarget[]

  @@index([venueId, restroomType])
}

model QrCode {
  id                    String             @id @default(cuid())
  uuid                  String             @unique @default(uuid())
  publisherId           String
  venueId               String?
  restroomId            String?
  assignedDistributorId String?
  qrName                String             @map("qr_name")
  qrSlug                String             @unique @map("qr_slug")
  publicToken           String             @unique @default(uuid()) @map("public_token")
  internalLabel         String?            @map("internal_label")
  placementType         QrPlacementType    @default(OTHER) @map("placement_type")
  isActive              Boolean            @default(true) @map("is_active")
  qrUrl                 String             @map("qr_url")
  destinationType       QrDestinationType  @default(GLOBAL)
  destinationUrl        String?
  issueId               String?
  slug                  String?
  qrType                QrCodeType         @default(RESTROOM) @map("qr_type")
  stickerTemplate       QrStickerTemplate  @default(STALL_DOOR) @map("sticker_template")
  shortUrl              String?            @map("short_url")
  callToAction          String             @default("Scan for Stall Talk") @map("call_to_action")
  status                QrCodeStatus       @default(DRAFT)
  installedAt           DateTime?          @map("installed_at")
  lastScanAt            DateTime?          @map("last_scan_at")
  installationPhotoUrl  String?            @map("installation_photo_url")
  campaignSource        String?            @map("campaign_source")
  advertisementSource   String?            @map("advertisement_source")
  promotionSource       String?            @map("promotion_source")
  couponSource          String?            @map("coupon_source")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  publisher             Publisher          @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  venue                 Venue?             @relation(fields: [venueId], references: [id], onDelete: SetNull)
  restroom              Restroom?          @relation(fields: [restroomId], references: [id], onDelete: SetNull)
  assignedDistributor   Distributor?       @relation(fields: [assignedDistributorId], references: [id], onDelete: SetNull)
  issues                Issue[]
  currentIssues         Issue[]            @relation("CurrentIssueQr")
  issueTargets          IssueTarget[]
  scans                 QrScan[]
  lifecycleEvents       QrLifecycleEvent[]
  events                AnalyticsEvent[]
  toiletLocations       ToiletLocation[]
  adSlotInventories     AdSlotInventory[]

  @@index([venueId, restroomId, status])
  @@index([qrType, status])
  @@map("qr_codes")
}

model Category {
  id          String    @id @default(cuid())
  publisherId String
  name        String
  slug        String
  color       String    @default("#ffd400")
  publisher   Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  articles    Article[]

  @@unique([publisherId, slug])
}

model Article {
  id          String              @id @default(cuid())
  publisherId String
  categoryId  String?
  title       String
  slug        String
  excerpt     String
  body        String
  imageUrl    String?
  status      IssueStatus         @default(DRAFT)
  scheduledAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  publisher   Publisher           @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  category    Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  blocks      IssueContentBlock[]
  venueIds    String[]            @default([])

  @@unique([publisherId, slug])
}

model RestaurantReview {
  id               String      @id @default(cuid())
  publisherId      String
  title            String
  restaurantName   String      @map("restaurant_name")
  venueId          String?     @map("venue_id")
  venueIds         String[]    @default([]) @map("venue_ids")
  featuredImageUrl String?     @map("featured_image_url")
  photoUrl         String?     @map("photo_url")
  starRating       Decimal     @default(5.0) @map("star_rating")
  cuisineType      String?     @map("cuisine_type")
  address          String?
  city             String?
  state            String?
  websiteUrl       String?     @map("website_url")
  instagramUrl     String?     @map("instagram_url")
  facebookUrl      String?     @map("facebook_url")
  reviewHeadline   String      @map("review_headline")
  reviewBody       String      @map("review_body")
  reviewerName     String      @map("reviewer_name")
  publishDate      DateTime?   @map("publish_date")
  status           IssueStatus @default(DRAFT)
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  publisher        Publisher   @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  venue            Venue?      @relation(fields: [venueId], references: [id], onDelete: SetNull)

  @@index([publisherId, status, publishDate])
  @@index([venueId])
  @@map("restaurant_reviews")
}

model DefaultIssue {
  id            String                     @id @default(cuid())
  slug          String                     @unique @default("default-public-issue")
  title         String
  description   String?
  month         Int
  year          Int
  status        String                     @default("DRAFT")
  publishedAt   DateTime?
  issueJson     Json?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  issues        Issue[]
  venues        Venue[]
  campaigns     StalltalkCampaignHistory[]
  contentBlocks IssueContentBlock[]
}

model Issue {
  id                       String      @id @default(cuid())
  publisherId              String?
  defaultIssueId           String?
  venueId                  String?
  restroomId               String?
  qrCodeId                 String?
  title                    String
  slug                     String?     @unique
  publicUrl                String?
  isGlobalIssue            Boolean     @default(false)
  isVenueIssue             Boolean     @default(false)
  isLocationIssue          Boolean     @default(false)
  month                    String
  year                     Int
  issueNumber              Int
  status                   IssueStatus @default(DRAFT)
  scheduledAt              DateTime?
  scheduledPublishAt       DateTime?
  timezone                 String?     @default("America/Los_Angeles")
  isScheduled              Boolean     @default(false)
  isPublished              Boolean     @default(false)
  isArchived               Boolean     @default(false)
  replaceDefaultOnPublish  Boolean     @default(true)
  archivePreviousOnPublish Boolean     @default(true)
  publishedAt              DateTime?
  republishedAt            DateTime?
  archivedAt               DateTime?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  publisher    Publisher?    @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  defaultIssue DefaultIssue? @relation(fields: [defaultIssueId], references: [id], onDelete: SetNull)
  venue        Venue?        @relation(fields: [venueId], references: [id], onDelete: SetNull)
  restroom     Restroom?     @relation(fields: [restroomId], references: [id], onDelete: SetNull)
  qrCode       QrCode?       @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)

  contentBlocks     IssueContentBlock[]
  adSlots           IssueAdSlot[]
  events            AnalyticsEvent[]
  importedEvents    Event[]
  qrScans           QrScan[]
  issueTargets      IssueTarget[]
  currentQrCodes    QrCode[]            @relation("CurrentIssueQr")
  adSlotInventories AdSlotInventory[]

  @@index([publisherId])
  @@index([defaultIssueId])
  @@index([venueId])
  @@index([restroomId])
  @@index([qrCodeId])
  @@index([slug])
  @@index([status])
  @@index([isScheduled, scheduledPublishAt])
  @@index([isPublished, isArchived])
  @@index([status, year, issueNumber])
  @@index([isScheduled, isPublished, isArchived, scheduledPublishAt])
  @@index([isPublished, isArchived, publishedAt])
}

model IssueContentBlock {
  id             String           @id @default(cuid())
  issueId        String
  defaultIssueId String?
  articleId      String?
  type           ContentBlockType
  sectionType    ContentBlockType @default(ARTICLE)
  title          String
  headline       String           @default("")
  isVisible      Boolean          @default(true)
  body           String
  imageUrl       String?
  layout         Json?
  venueIds       String[]         @default([])
  sortOrder      Int              @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  issue          Issue            @relation(fields: [issueId], references: [id], onDelete: Cascade)
  defaultIssue   DefaultIssue?    @relation(fields: [defaultIssueId], references: [id], onDelete: SetNull)
  article        Article?         @relation(fields: [articleId], references: [id], onDelete: SetNull)
}

model Ad {
  id                   String                     @id @default(cuid())
  publisherId          String?
  advertiserId         String?
  businessName         String
  title                String
  offer                String
  artworkUrl           String?
  creativeType         String                     @default("IMAGE")
  htmlCreative         String?
  videoUrl             String?
  promptUsed           String?
  creativeBrief        String?
  generatedHeadline    String?
  generatedSubheadline String?
  adSize               String?
  ctaText              String
  targetUrl            String
  phone                String?
  couponCode           String?
  status               AdStatus                   @default(ACTIVE)
  scope                AdScope                    @default(GLOBAL)
  city                 String?
  state                String?
  venueId              String?
  venueIds             String[]                   @default([])
  restroomId           String?
  monthlyPriceCents    Int                        @default(0)
  stripePriceId        String?
  campaignStartsAt     DateTime?
  campaignEndsAt       DateTime?
  viewCount            Int                        @default(0)
  clickCount           Int                        @default(0)
  lastViewedAt         DateTime?
  lastClickedAt        DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  publisher            Publisher?                 @relation(fields: [publisherId], references: [id], onDelete: SetNull)
  advertiser           Advertiser?                @relation(fields: [advertiserId], references: [id], onDelete: SetNull)
  venue                Venue?                     @relation(fields: [venueId], references: [id], onDelete: SetNull)
  restroom             Restroom?                  @relation(fields: [restroomId], references: [id], onDelete: SetNull)
  issueSlots           IssueAdSlot[]
  campaignHistory      StalltalkCampaignHistory[]
  adSlots              StalltalkAdSlot[]
  events               AnalyticsEvent[]
  subscriptions        StripeSubscription[]
  adCampaigns          AdCampaign[]
}

model Event {
  id          String      @id @default(cuid())
  issueId     String?
  title       String
  date        DateTime
  startTime   String?
  endTime     String?
  venue       String
  address     String?
  description String
  category    String?
  priceLabel  String?
  sourceUrl   String
  sourceName  String
  imageUrl    String?
  issueMonth  String
  issueYear   Int
  importedAt  DateTime    @default(now())
  status      EventStatus @default(PENDING_REVIEW)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  issue       Issue?      @relation(fields: [issueId], references: [id], onDelete: SetNull)

  @@unique([title, date, venue])
  @@index([issueMonth, issueYear, status])
  @@index([issueId, status])
}

model IssueAdSlot {
  id         String  @id @default(cuid())
  issueId    String
  adId       String
  slotNumber Int
  source     AdScope @default(GLOBAL)
  issue      Issue   @relation(fields: [issueId], references: [id], onDelete: Cascade)
  ad         Ad      @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@unique([issueId, slotNumber])
}

model StalltalkCampaignHistory {
  id                  String        @id @default(cuid())
  publisherId         String?
  defaultIssueId      String?
  advertiserId        String?
  adId                String?
  campaignId          String        @unique
  parentCampaignId    String?
  versionNumber       Int           @default(1)
  business            String
  image               String?
  prompt              String
  creativeBrief       String?
  headline            String?
  subheadline         String?
  ctaText             String?
  couponCode          String?
  adSize              String        @default("Mobile Sponsor Card")
  logoBase64          String?
  logoUrl             String?
  targetUrl           String?
  targetType          String?
  targetLabel         String?
  issueId             String?
  venueId             String?
  restroomId          String?
  placement           String?
  publishedToHomepage Boolean       @default(false)
  selectedSlot        Int?
  slotPublished       Int?
  publishStatus       String        @default("DRAFT")
  publishedAt         DateTime?
  viewCount           Int           @default(0)
  clickCount          Int           @default(0)
  lastViewedAt        DateTime?
  lastClickedAt       DateTime?
  createdAt           DateTime      @default(now())
  publisher           Publisher?    @relation(fields: [publisherId], references: [id], onDelete: SetNull)
  defaultIssue        DefaultIssue? @relation(fields: [defaultIssueId], references: [id], onDelete: SetNull)
  advertiser          Advertiser?   @relation(fields: [advertiserId], references: [id], onDelete: SetNull)
  ad                  Ad?           @relation(fields: [adId], references: [id], onDelete: SetNull)

  @@index([parentCampaignId, versionNumber])
  @@index([targetType, publishStatus, slotPublished])
  @@index([issueId, venueId, restroomId])
  @@map("stalltalk_campaign_history")
}

model StalltalkAdSlot {
  id           String     @id @default(cuid())
  slotNumber   Int        @unique
  adId         String?
  business     String
  creativeType String     @default("IMAGE")
  image        String?
  htmlCreative String?
  videoUrl     String?
  prompt       String?
  headline     String?
  subheadline  String?
  ctaText      String?
  couponCode   String?
  targetUrl    String?
  phone        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  ad           Ad?        @relation(fields: [adId], references: [id], onDelete: SetNull)
  publisher    Publisher? @relation(fields: [publisherId], references: [id])
  publisherId  String?

  @@map("stalltalk_ad_slots")
}

model AnalyticsEvent {
  id           String             @id @default(cuid())
  publisherId  String?
  venueId      String?
  restroomId   String?
  qrCodeId     String?
  issueId      String?
  advertiserId String?
  adId         String?
  type         AnalyticsEventType
  slotNumber   Int?
  visitorId    String?
  sessionId    String?
  durationMs   Int?
  path         String?
  metadata     Json?
  createdAt    DateTime           @default(now())
  publisher    Publisher?         @relation(fields: [publisherId], references: [id], onDelete: SetNull)
  advertiser   Advertiser?        @relation(fields: [advertiserId], references: [id], onDelete: SetNull)
  venue        Venue?             @relation(fields: [venueId], references: [id], onDelete: SetNull)
  restroom     Restroom?          @relation(fields: [restroomId], references: [id], onDelete: SetNull)
  qrCode       QrCode?            @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)
  issue        Issue?             @relation(fields: [issueId], references: [id], onDelete: SetNull)
  ad           Ad?                @relation(fields: [adId], references: [id], onDelete: SetNull)
}

model QrScan {
  id                  String     @id @default(cuid())
  qrCodeId            String     @map("qr_code_id")
  publisherId         String?    @map("publisher_id")
  venueId             String?    @map("venue_id")
  restroomId          String?    @map("restroom_id")
  issueId             String?    @map("issue_id")
  visitorId           String?    @map("visitor_id")
  sessionId           String?    @map("session_id")
  deviceType          String?    @map("device_type")
  browser             String?
  operatingSystem     String?    @map("operating_system")
  city                String?
  state               String?
  country             String?
  referralSource      String?    @map("referral_source")
  campaignSource      String?    @map("campaign_source")
  advertisementSource String?    @map("advertisement_source")
  promotionSource     String?    @map("promotion_source")
  couponSource        String?    @map("coupon_source")
  dwellTimeMs         Int?       @map("dwell_time_ms")
  metadata            Json?
  scannedAt           DateTime   @default(now()) @map("scanned_at")
  qrCode              QrCode     @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  publisher           Publisher? @relation(fields: [publisherId], references: [id], onDelete: SetNull)
  venue               Venue?     @relation(fields: [venueId], references: [id], onDelete: SetNull)
  restroom            Restroom?  @relation(fields: [restroomId], references: [id], onDelete: SetNull)
  issue               Issue?     @relation(fields: [issueId], references: [id], onDelete: SetNull)

  @@index([qrCodeId, scannedAt])
  @@index([venueId, scannedAt])
  @@map("qr_scans")
}

model IssueTarget {
  id          String          @id @default(cuid())
  issueId     String
  venueId     String
  restroomId  String?
  qrCodeId    String?
  targetType  IssueTargetType
  isLive      Boolean         @default(false)
  publishAt   DateTime?
  unpublishAt DateTime?
  canceledAt  DateTime?
  publishedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  issue       Issue           @relation(fields: [issueId], references: [id], onDelete: Cascade)
  venue       Venue           @relation(fields: [venueId], references: [id], onDelete: Cascade)
  restroom    Restroom?       @relation(fields: [restroomId], references: [id], onDelete: Cascade)
  qrCode      QrCode?         @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@index([venueId, targetType, publishAt])
  @@index([qrCodeId, targetType, publishAt])
  @@index([restroomId, targetType, publishAt])
}

model QrLifecycleEvent {
  id        String            @id @default(cuid())
  qrCodeId  String            @map("qr_code_id")
  action    QrLifecycleAction
  note      String?
  createdAt DateTime          @default(now()) @map("created_at")
  qrCode    QrCode            @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@index([qrCodeId, createdAt])
  @@map("qr_lifecycle_events")
}

model StripeSubscription {
  id                   String                   @id @default(cuid())
  advertiserId         String
  adId                 String?
  stripeCustomerId     String
  stripeSubscriptionId String
  status               StripeSubscriptionStatus @default(TRIALING)
  locations            Int                      @default(1)
  monthlyAmountCents   Int
  currentPeriodEndsAt  DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  advertiser           Advertiser               @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  ad                   Ad?                      @relation(fields: [adId], references: [id], onDelete: SetNull)
}

model ToiletLocation {
  id          String            @id @default(cuid())
  venueId     String
  restroomId  String?
  qrCodeId    String?
  name        String
  label       String
  placement   String?
  status      AccountStatus     @default(ACTIVE)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  venue       Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)
  restroom    Restroom?         @relation(fields: [restroomId], references: [id], onDelete: SetNull)
  qrCode      QrCode?           @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)
  inventories AdSlotInventory[]

  @@index([venueId])
  @@index([restroomId])
  @@index([qrCodeId])
}

model AdSlotInventory {
  id                 String                @id @default(cuid())
  venueId            String
  issueId            String?
  restroomId         String?
  qrCodeId           String?
  toiletLocationId   String?
  slotNumber         Int
  month              String
  audienceSegment    String                @default("ALL_RESTROOMS")
  eventCategory      String?
  locationLabel      String?
  gender             String?
  startsAt           DateTime?
  endsAt             DateTime?
  priceCents         Int                   @default(5000)
  status             InventoryStatus       @default(OPEN)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  venue              Venue                 @relation(fields: [venueId], references: [id], onDelete: Cascade)
  issue              Issue?                @relation(fields: [issueId], references: [id], onDelete: Cascade)
  restroom           Restroom?             @relation(fields: [restroomId], references: [id], onDelete: SetNull)
  qrCode             QrCode?               @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)
  toiletLocation     ToiletLocation?       @relation(fields: [toiletLocationId], references: [id], onDelete: SetNull)
  campaigns          AdCampaign[]
  campaignPlacements AdCampaignPlacement[]

  @@unique([issueId, venueId, restroomId, qrCodeId, slotNumber, month])
  @@index([issueId, status])
  @@index([issueId, month, qrCodeId, status])
  @@index([audienceSegment])
  @@index([status, month])
}

model AdCampaign {
  id                          String                @id @default(cuid())
  advertiserId                String
  inventoryId                 String?
  adId                        String?
  name                        String
  businessName                String
  headline                    String
  body                        String
  description                 String?
  creativeUrl                 String?
  creativeBrief               String?
  targetUrl                   String                @default("#")
  ctaText                     String                @default("Learn More")
  months                      Int                   @default(1)
  locationCount               Int                   @default(1)
  priceCents                  Int                   @default(5000)
  budgetCents                 Int                   @default(0)
  remainingBudgetCents        Int                   @default(0)
  flightStartMonth            String                @default("2026-07")
  flightEndMonth              String                @default("2026-07")
  flightMonths                Int                   @default(1)
  pricePerPlacementMonthCents Int                   @default(5000)
  placementCount              Int                   @default(1)
  totalAmountCents            Int                   @default(5000)
  targetType                  TargetType            @default(GLOBAL_NETWORK)
  targetStates                String[]              @default([])
  targetCities                String[]              @default([])
  targetVenueIds              String[]              @default([])
  targetVenueTypes            String[]              @default([])
  impressionsServed           Int                   @default(0)
  clicksServed                Int                   @default(0)
  qrScans                     Int                   @default(0)
  estimatedCpmCents           Int                   @default(0)
  estimatedCpcCents           Int                   @default(0)
  status                      CampaignStatus        @default(DRAFT)
  approvalStatus              ApprovalStatus        @default(PENDING)
  adminApprovalNote           String?
  rejectionReason             String?
  stripeSessionId             String?               @unique
  paidAt                      DateTime?
  startsAt                    DateTime?
  endsAt                      DateTime?
  submittedAt                 DateTime?
  approvedAt                  DateTime?
  rejectedAt                  DateTime?
  approvedBy                  String?
  rejectedBy                  String?
  publishedAt                 DateTime?
  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime              @updatedAt
  advertiser                  Advertiser            @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  inventory                   AdSlotInventory?      @relation(fields: [inventoryId], references: [id], onDelete: SetNull)
  ad                          Ad?                   @relation(fields: [adId], references: [id], onDelete: SetNull)
  payments                    Payment[]
  placements                  AdCampaignPlacement[]
  creatives                   AdCreative[]
  invoices                    AdvertiserInvoice[]

  @@index([advertiserId, status])
  @@index([inventoryId])
  @@index([flightStartMonth, flightEndMonth])
}

model AdCampaignPlacement {
  id          String          @id @default(cuid())
  campaignId  String
  inventoryId String
  createdAt   DateTime        @default(now())
  campaign    AdCampaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  inventory   AdSlotInventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@unique([campaignId, inventoryId])
  @@index([inventoryId])
}

model AdCreative {
  id             String                 @id @default(cuid())
  campaignId     String
  advertiserId   String
  kind           CreativeKind           @default(IMAGE)
  imageUrl       String?
  headline       String
  body           String
  callToAction   String                 @default("Learn More")
  destinationUrl String                 @default("#")
  approvalStatus CreativeApprovalStatus @default(SUBMITTED)
  reviewNote     String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  campaign       AdCampaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  advertiser     Advertiser             @relation(fields: [advertiserId], references: [id], onDelete: Cascade)

  @@index([advertiserId, approvalStatus])
  @@index([campaignId])
}

model AdvertiserInvoice {
  id               String        @id @default(cuid())
  advertiserId     String
  campaignId       String?
  invoiceNumber    String        @unique
  amountCents      Int
  currency         String        @default("usd")
  status           InvoiceStatus @default(DRAFT)
  stripeCustomerId String?
  stripeInvoiceId  String?
  createdAt        DateTime      @default(now())
  paidAt           DateTime?
  advertiser       Advertiser    @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  campaign         AdCampaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([advertiserId, status])
}

model Payment {
  id                    String        @id @default(cuid())
  campaignId            String
  advertiserId          String
  amountCents           Int
  currency              String        @default("usd")
  status                PaymentStatus @default(PENDING)
  stripeSessionId       String?       @unique
  stripePaymentIntentId String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  campaign              AdCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  advertiser            Advertiser    @relation(fields: [advertiserId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([advertiserId])
}

model VenueContentDraft {
  id              String           @id @default(cuid())
  venueId         String
  contentType     VenueContentType @default(ANNOUNCEMENT)
  title           String
  body            String
  imageUrl        String?
  location        String?
  websiteUrl      String?
  category        String?
  startsAt        DateTime?
  endsAt          DateTime?
  expiresAt       DateTime?
  couponCode      String?
  qrDestination   String?
  approvalStatus  ApprovalStatus   @default(DRAFT)
  adminNote       String?
  rejectionReason String?
  submittedAt     DateTime?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  publishedAt     DateTime?
  approvedBy      String?
  rejectedBy      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  venue           Venue            @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId, contentType, approvalStatus])
  @@index([venueId, startsAt, endsAt])
}

model VenueMediaAsset {
  id          String         @id @default(cuid())
  venueId     String
  assetType   MediaAssetType @default(IMAGE)
  title       String
  url         String
  altText     String?
  galleryName String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  venue       Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId, assetType])
}

model CouponCampaign {
  id              String     @id @default(cuid())
  advertiserId    String
  name            String
  couponCode      String
  budgetCents     Int        @default(0)
  redemptionLimit Int?
  startsAt        DateTime?
  endsAt          DateTime?
  createdAt       DateTime   @default(now())
  advertiser      Advertiser @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
}

model CommissionReport {
  id                String      @id @default(cuid())
  distributorId     String
  month             String
  year              Int
  grossRevenueCents Int
  commissionCents   Int
  status            String      @default("OPEN")
  createdAt         DateTime    @default(now())
  distributor       Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)
}

model PublishedContent {
  id          String   @id @default(cuid())
  issue       Json
  ads         Json
  events      Json
  venues      Json
  settings    Json
  publishedAt DateTime @default(now())
  publishedBy Json?
  createdAt   DateTime @default(now())

  @@index([publishedAt])
}
